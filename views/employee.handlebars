<h1>{{employee.name}}</h1>
<p>Phone: {{employee.phone}}</p>
<a href="/employee/{{employee._id}}/edit">Edit Details</a>

<h2>Shifts</h2>
<table>
    <tr>
        <th>Date</th>
        <th>Start Time</th>
        <th>End Time</th>
    </tr>
    {{#each schedule}}
    <tr>
        <td>{{this.date}}</td>
        <td class="{{#if this.isMorning}}morning{{/if}}">{{this.startTime}}</td>
        <td>{{this.endTime}}</td>
    </tr>
    {{/each}}
</table>

<h2>Documents</h2>
{{#if documents.length}}
<ul>
    {{#each documents}}
    <li>
        <a href="/document/{{this._id}}">{{this.originalName}}</a>
    </li>
    {{/each}}
</ul>
{{else}}
<p>No documents uploaded.</p>
{{/if}}

{{#if canUpload}}
<h3>Upload Document</h3>
<p>PDF only, max 2MB, up to 5 documents per employee.</p>
<form action="/employee/{{employee._id}}/upload" method="POST" enctype="multipart/form-data">
    <input type="file" name="document" accept=".pdf"><br><br>
    <button type="submit">Upload</button>
</form>
{{else}}
<p>Maximum number of documents reached (5).</p>
{{/if}}

<br>
<a href="/">Back to Employees</a>